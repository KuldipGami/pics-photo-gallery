{
  "name": "pics",
  "productName": "Pics",
  "version": "1.17.0",
  "description": "A modern photo and video gallery for your desktop",
  "author": "Kuldip",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "icon": "electron scripts/make-icon.cjs",
    "models": "node scripts/get-models.mjs",
    "dist": "vite build && electron-builder --win",
    "store-assets": "node scripts/make-store-assets.mjs",
    "store": "node scripts/build-store.mjs"
  },
  "build": {
    "appId": "app.lumen.gallery",
    "productName": "Pics",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "resources/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/{linux,darwin}/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx",
          "places.json.gz",
          "siglip/*.onnx",
          "siglip/tokenizer.json",
          "siglip/calibration.json",
          "lama/lama.onnx"
        ]
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "appx": {
      "applicationId": "Pics",
      "displayName": "Pics – Photos &amp; Videos",
      "identityName": "KuldipGami.PicsPhotosVideos",
      "publisher": "CN=6B0590BC-9ABE-4F13-82CC-2D3941731FB5",
      "publisherDisplayName": "Kuldip Gami",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "onnxruntime-node": "^1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
